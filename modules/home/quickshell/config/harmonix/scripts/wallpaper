#!/usr/bin/env bash
#
# Wallpaper source of truth for the Quickshell launcher's wallpaper mode.
#
# The live wallpaper is a symlink ($DIR/wallpaper) rather than a path, so
# hyprpaper and matugen always point at one stable file and switching only has
# to repoint the link.
#
# Dependencies:
#   - hyprpaper (hyprctl)
#   - matugen
#   - curl, jq (fetch only)
#
# Usage:
#   wallpaper list         List every wallpaper in the directory, one per line
#   wallpaper current      Print what the symlink currently resolves to
#   wallpaper set PATH     Repoint the symlink at PATH and re-theme the session
#   wallpaper fetch [Q]    Download a wallpaper matching Q (default: a random
#                          one of the themes below) and apply it
#   wallpaper mode         Print the colour mode ("light" or "dark")
#   wallpaper mode M       Set the colour mode to light|dark|toggle and
#                          re-theme the session from the current wallpaper

set -euo pipefail

# HARMONIX_WALLPAPERS is set by the quickshell systemd unit from vars.repoPath.
DIR="${HARMONIX_WALLPAPERS:-$HOME/harmonix/wallpapers}"
LINK="$DIR/wallpaper"

# Whether matugen renders the light or the dark half of the palette. Kept
# outside the repo (and outside $DIR, which the picker lists) because it is
# session state, not configuration: the generated matugen-colors.* files it
# decides the contents of are gitignored for the same reason.
MODE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/harmonix/color-mode"

# What `fetch` looks for when it isn't given a query. One is drawn at random
# per call: a single fixed query returns the same handful of images however
# the API is sorted, where a register of related ones keeps the results
# varied without wandering out of the theme.
THEMES=(
  "dark fantasy"
  "medieval castle"
)

list() {
  # The extension filter also keeps the extensionless symlink out of the list.
  find -L "$DIR" -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) |
    sort
}

current() {
  if [[ -L $LINK ]]; then
    readlink -f "$LINK"
  fi
}

mode_get() {
  local mode
  mode=$(cat "$MODE_FILE" 2>/dev/null || true)

  case $mode in
  light | dark) printf '%s\n' "$mode" ;;
  *) printf 'dark\n' ;;
  esac
}

mode_set() {
  local requested=$1 mode

  case $requested in
  light | dark) mode=$requested ;;
  toggle) [[ $(mode_get) == dark ]] && mode=light || mode=dark ;;
  *)
    printf 'usage: %s mode <light|dark|toggle>\n' "${0##*/}" >&2
    exit 1
    ;;
  esac

  mkdir -p "${MODE_FILE%/*}"
  printf '%s\n' "$mode" >"$MODE_FILE"

  # The wallpaper doesn't change, only how it is read: re-run the same apply
  # so every template is re-rendered and every post_hook fires again.
  local target
  target=$(current)

  if [[ -n $target ]]; then
    apply "$target" >/dev/null
  else
    theme_gtk "$mode"
  fi

  # stdout is the new mode and nothing else -- that is what the caller reads
  # back.
  printf '%s\n' "$mode"
}

# GTK's own light/dark preference is separate from the palette matugen writes:
# the gtk4 template emits both halves behind prefers-color-scheme queries, and
# libadwaita apps pick between them from this key -- so without it they stay
# dark while everything around them turns light. Written with dconf rather
# than gsettings because that is what is on PATH here, and it is the same key
# Home Manager seeds at activation (modules/home/gtk/default.nix), which is
# why a rebuild resets the session to dark.
#
# GTK3 apps are not covered: their preference lives in a settings.ini written
# by Home Manager and read once at startup.
theme_gtk() {
  local mode=$1

  dconf write /org/gnome/desktop/interface/color-scheme "'prefer-$mode'" || true
}

apply() {
  local target=$1
  local mode
  mode=$(mode_get)

  if [[ ! -f $target ]]; then
    notify-send "Wallpaper" "No such file: $target"
    exit 1
  fi

  ln -sf "$target" "$LINK"

  # hyprpaper resolves the symlink itself, so pointing it back at the same
  # path picks up the new image. Only `wallpaper` is accepted over hyprctl in
  # this build -- preload/unload/listloaded answer "invalid hyprpaper
  # request" and a non-zero exit, which under `set -e` would abort here and
  # leave the symlink changed but the screen untouched.
  hyprctl hyprpaper wallpaper ",$LINK" >/dev/null

  # Hand matugen the real file, not the symlink: the image format is worked
  # out from the extension, which the link doesn't have. The mode is always
  # explicit rather than `smart` -- the choice is the user's, made with `M` in
  # the launcher's wallpaper picker, not the image's. `--prefer` is not
  # optional: without it matugen aborts on any image it finds more than one
  # candidate source colour in, and there is no terminal here to ask. Darkness
  # stays the preference in light mode too, where a dark accent is what reads
  # against a light background.
  matugen image "$target" -m "$mode" --prefer darkness -t scheme-content

  theme_gtk "$mode"
}

# Wallhaven's search API is open for SFW results, so there is no key to keep
# out of the repo. categories=100 is "general" (no anime, no people) and
# purity=100 is SFW; sorting=random is what makes the button worth pressing
# twice.
fetch() {
  local query=${1:-${THEMES[RANDOM % ${#THEMES[@]}]}}
  local json url dest

  if ! json=$(curl -fsSL --get "https://wallhaven.cc/api/v1/search" \
    --data-urlencode "q=$query" \
    --data-urlencode "categories=100" \
    --data-urlencode "purity=100" \
    --data-urlencode "sorting=random" \
    --data-urlencode "atleast=1920x1080" \
    --data-urlencode "ratios=16x9"); then
    notify-send "Wallpaper" "Could not reach Wallhaven"
    exit 1
  fi

  url=$(jq -r '.data[0].path // empty' <<<"$json")

  if [[ -z $url ]]; then
    notify-send "Wallpaper" "Nothing found for \"$query\""
    exit 1
  fi

  # Downloaded beside the rest so the picker lists it like any other, under
  # Wallhaven's own filename (already "wallhaven-<id>.<ext>", which doubles
  # as the credit) and written through a .part file so a half-finished
  # download can never be picked up as a wallpaper.
  dest="$DIR/$(basename "$url")"

  if ! curl -fsSL -o "$dest.part" "$url"; then
    rm -f "$dest.part"
    notify-send "Wallpaper" "Download failed"
    exit 1
  fi

  mv "$dest.part" "$dest"

  # stdout is the path and nothing else -- that is what the caller reads
  # back -- so hyprpaper's and matugen's chatter is dropped here. Their
  # stderr is left alone, so a real failure still surfaces.
  apply "$dest" >/dev/null
  printf '%s\n' "$dest"
}

case ${1:-} in
list) list ;;
current) current ;;
set) apply "${2:?usage: wallpaper set PATH}" ;;
fetch) fetch "${2:-}" ;;
mode)
  if [[ -n ${2:-} ]]; then mode_set "$2"; else mode_get; fi
  ;;
*)
  printf 'usage: %s <list|current|set PATH|fetch [QUERY]|mode [light|dark|toggle]>\n' "${0##*/}" >&2
  exit 1
  ;;
esac
