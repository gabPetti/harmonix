# ~/.config/zathura/zathurarc

# Palette, regenerated by matugen on every wallpaper change. The path is
# relative, which zathura resolves against this file's own directory.
include matugen-colors.conf

set selection-clipboard clipboard

# Recolour the page into the palette above rather than leaving it white.
set recolor true

# Keep the hue of coloured figures instead of mapping everything onto the
# two recolor endpoints; only the black-on-white body text gets inverted.
set recolor-keephue true
